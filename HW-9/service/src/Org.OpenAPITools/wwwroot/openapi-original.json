            "description" : "Тело некорректно: конец не позже начала, длительность больше 12 часов,\nинтервал вне часов работы комнаты, пустое имя или слишком длинный комментарий.\n"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "unauthenticated",
                  "message" : "Нужна авторизация"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Пользователя установить не удалось: заголовок Authorization отсутствует,\nсхема не Bearer, JWT повреждён или срок токена истёк.\n"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "forbidden",
                  "message" : "Бронировать эту переговорку нельзя"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Пользователь известен, но бронировать эту переговорку ему нельзя."
          },
          "404" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "room_not_found",
                  "message" : "Переговорка не найдена"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Переговорки с таким id нет."
          },
          "409" : {
