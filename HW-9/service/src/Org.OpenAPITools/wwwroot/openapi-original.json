{
  "openapi" : "3.0.3",
  "info" : {
    "description" : "API бронирования переговорок в офисе.\n\nКто вызывает метод, сервер узнаёт из JWT. Имя и идентификатор пользователя\nв параметрах и в теле не передаются.\n\n401 — пользователя установить не удалось (нет токена, токен повреждён или просрочен).\n403 — пользователь известен, но это действие ему запрещено.\n\nНаружу выходят только публичные DTO из `components.schemas`.\nСписок комнаты, карточка комнаты, строка календаря и бронь — разные схемы.\n\nБронь занимает полуинтервал `[startsAt, endsAt)`: стык встык конфликтом не считается.\n",
    "title" : "Бронирование переговорок",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "/api/v1"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Переговорки и их календарь",
    "name" : "rooms"
  }, {
    "description" : "Бронирования",
    "name" : "bookings"
  } ],
  "paths" : {
    "/rooms" : {
      "get" : {
        "description" : "Возвращает публичные карточки комнат. Без фильтров — все комнаты.\nПустой результат — это `200` и пустой массив, а не `404`.\n",
        "operationId" : "listRooms",
        "parameters" : [ {
          "description" : "Точный этаж. Подвал допустим.",
          "explode" : true,
          "in" : "query",
          "name" : "floor",
          "required" : false,
          "schema" : {
            "example" : 5,
            "maximum" : 100,
            "minimum" : -2,
            "type" : "integer"
          },
          "style" : "form"
        }, {
          "description" : "Минимально нужная вместимость. В ответ попадут комнаты,\nу которых `capacity` не меньше этого значения.\n",
          "explode" : true,
          "in" : "query",
          "name" : "capacity",
          "required" : false,
          "schema" : {
            "example" : 6,
            "maximum" : 500,
            "minimum" : 1,
            "type" : "integer"
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "example" : [ {
                  "id" : "6b1f3c2a-7e4d-4a1b-9c8e-2f5d6a7b8c90",
                  "name" : "Орбита",
                  "floor" : 5,
                  "capacity" : 8,
                  "amenities" : {
                    "tv" : true,
                    "whiteboard" : true,
                    "videoConference" : true
                  }
                }, {
                  "id" : "1c2d3e4f-5a6b-4789-8abc-def012345678",
                  "name" : "Тихая",
                  "floor" : 5,
                  "capacity" : 4,
                  "amenities" : {
                    "tv" : false,
                    "whiteboard" : true,
                    "videoConference" : false
                  }
                } ],
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Room"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "Список переговорок."
          },
          "400" : {
            "content" : {
              "application/json" : {
                "examples" : {
                  "floor" : {
                    "summary" : "Плохой этаж",
                    "value" : {
                      "code" : "invalid_floor",
                      "message" : "Этаж должен быть целым числом от -2 до 100"
                    }
                  },
                  "capacity" : {
                    "summary" : "Плохая вместимость",
                    "value" : {
                      "code" : "invalid_capacity",
                      "message" : "Вместимость должна быть целым числом от 1 до 500"
                    }
                  }
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Фильтр некорректный: `floor` или `capacity` не целое число\nлибо выходит за допустимый диапазон. У `capacity` ещё и минимум 1.\n"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "unauthenticated",
                  "message" : "Нужна авторизация"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Пользователя установить не удалось: заголовок Authorization отсутствует,\nсхема не Bearer, JWT повреждён или срок токена истёк.\n"
          }
        },
        "summary" : "Получить список переговорок",
        "tags" : [ "rooms" ]
      }
    },
    "/rooms/{roomId}" : {
      "get" : {
        "description" : "Карточка одной комнаты. Поля списка здесь те же, плюс сведения, нужные чтобы дойти и выбрать время.",
        "operationId" : "getRoom",
        "parameters" : [ {
          "description" : "Идентификатор переговорки.",
          "explode" : false,
          "in" : "path",
          "name" : "roomId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "id" : "6b1f3c2a-7e4d-4a1b-9c8e-2f5d6a7b8c90",
                  "name" : "Орбита",
                  "floor" : 5,
                  "capacity" : 8,
                  "amenities" : {
                    "tv" : true,
                    "whiteboard" : true,
                    "videoConference" : true
                  },
                  "description" : "Угловая комната с окнами во двор и большим столом.",
                  "directions" : "5 этаж, левое крыло, третья дверь за ресепшен.",
                  "photos" : [ {
                    "url" : "https://cdn.example.com/rooms/orbita.jpg",
                    "caption" : "Общий вид"
                  } ],
                  "workingHours" : [ {
                    "weekday" : "monday",
                    "opensAt" : "09:00",
                    "closesAt" : "19:00"
                  } ],
                  "timeZone" : "Europe/Yekaterinburg"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/RoomDetails"
                }
              }
            },
            "description" : "Карточка переговорки."
          },
          "401" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "unauthenticated",
                  "message" : "Нужна авторизация"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Пользователя установить не удалось: заголовок Authorization отсутствует,\nсхема не Bearer, JWT повреждён или срок токена истёк.\n"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "room_not_found",
                  "message" : "Переговорка не найдена"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Переговорки с таким id нет."
          }
        },
        "summary" : "Получить переговорку",
        "tags" : [ "rooms" ]
      }
    },
    "/rooms/{roomId}/calendar" : {
      "get" : {
        "description" : "Брони одной комнаты внутри запрошенного окна.\nОкно включительно по `from` и исключительно по `to`.\nКомментарии броней в календарь не входят.\n",
        "operationId" : "getRoomCalendar",
        "parameters" : [ {
          "description" : "Идентификатор переговорки.",
          "explode" : false,
          "in" : "path",
          "name" : "roomId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          },
          "style" : "simple"
        }, {
          "description" : "Начало окна просмотра, включительно.",
          "explode" : true,
          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "example" : "2026-11-10T00:00:00+05:00",
            "format" : "date-time",
            "type" : "string"
          },
          "style" : "form"
        }, {
          "description" : "Конец окна просмотра, исключительно. Должен быть позже `from`, окно не длиннее 90 суток.",
          "explode" : true,
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "example" : "2026-11-17T00:00:00+05:00",
            "format" : "date-time",
            "type" : "string"
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "roomId" : "6b1f3c2a-7e4d-4a1b-9c8e-2f5d6a7b8c90",
                  "from" : "2026-11-10T00:00:00+05:00",
                  "to" : "2026-11-17T00:00:00+05:00",
                  "bookings" : [ {
                    "id" : "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
                    "startsAt" : "2026-11-10T10:00:00+05:00",
                    "endsAt" : "2026-11-10T11:30:00+05:00",
                    "title" : "Планёрка команды",
                    "bookedBy" : "Анна Смирнова"
                  } ]
                },
                "schema" : {
                  "$ref" : "#/components/schemas/RoomCalendar"
                }
              }
            },
            "description" : "Окно календаря и брони внутри него. Броней может не быть."
          },
          "400" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "invalid_interval",
                  "message" : "Конец окна должен быть позже начала, а само окно не длиннее 90 суток"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Окно задано неверно: нет `from` или `to`, это не дата-время,\n`to` не позже `from`, либо окно длиннее 90 суток.\n"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "unauthenticated",
                  "message" : "Нужна авторизация"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Пользователя установить не удалось: заголовок Authorization отсутствует,\nсхема не Bearer, JWT повреждён или срок токена истёк.\n"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "example" : {
                  "code" : "room_not_found",
                  "message" : "Переговорка не найдена"
                },
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Переговорки с таким id нет."
          }
        },
        "summary" : "Получить календарь переговорки",
        "tags" : [ "rooms" ]
      }
    },
    "/rooms/{roomId}/bookings" : {
      "post" : {
        "description" : "Создаёт бронь. Кто бронирует, берётся из JWT и возвращается в `bookedBy`.\n`403`, если комната есть, но этому пользователю её бронировать нельзя.\nНесуществующая комната — `404`, а не `403`.\n",
        "operationId" : "createBooking",
        "parameters" : [ {
          "description" : "Идентификатор переговорки.",
          "explode" : false,
          "in" : "path",
